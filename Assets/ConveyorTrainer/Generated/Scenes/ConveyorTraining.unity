    - target: {fileID: 9008091181505925496, guid: 95aa451921bcb3847bac07379003ddce,
        type: 3}
      propertyPath: m_Text
      value: "\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415 XR-\u0421\u0418\u041C\u0423\u041B\u042F\u0422\u041E\u0420\u041E\u041C\nT
        / Y \u2014 \u043B\u0435\u0432\u0430\u044F / \u043F\u0440\u0430\u0432\u0430\u044F
        \u0440\u0443\u043A\u0430\n\u041F\u041A\u041C \u2014 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
        \u0433\u043E\u043B\u043E\u0432\u043E\u0439\nWASD / Q E \u2014 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435
        \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\nR \u2014 \u043F\u043E\u0432\u043E\u0440\u043E\u0442
        / \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043C\u044B\u0448\u044C\u044E\nG
        \u2014 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\n\u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
        \u043A \u043A\u0440\u0435\u043F\u0435\u0436\u0443 + \u041B\u041A\u041C \u2014
        \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\n\u0421\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F
        \u0440\u0443\u043A\u0430: \u041B\u041A\u041C \u2014 \u043A\u043D\u043E\u043F\u043A\u0438
        / UI / \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442"
      objectReference: {fileID: 0}
