    targetId: 
  - requirement: 9
    instruction: "\u041A\u043B\u044E\u0447\u043E\u043C \u0437\u0430\u0442\u044F\u043D\u0438\u0442\u0435
      \u043E\u0431\u0435 \u0433\u0430\u0439\u043A\u0438."
    targetId: sensor.nut.0
  - requirement: 10
    instruction: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043A\u0430\u0431\u0435\u043B\u044C
