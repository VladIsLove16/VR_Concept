  title: "\u0417\u0430\u043C\u0435\u043D\u0430 \u0434\u0430\u0442\u0447\u0438\u043A\u0430"
  briefing: "\u0417\u0430\u043C\u0435\u043D\u0438\u0442\u0435 \u043D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u044B\u0439
    \u0434\u0430\u0442\u0447\u0438\u043A. \u041D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043C\u043E\u0436\u043D\u043E
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C."
  fault: 1
  guided: 1
  steps:
  - requirement: 4
    instruction: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u043B\u0438\u043D\u0438\u044E."
    targetId: power
  - requirement: 5
    instruction: "\u041E\u0442\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435
      \u043A\u0430\u0431\u0435\u043B\u044C \u0434\u0430\u0442\u0447\u0438\u043A\u0430."
