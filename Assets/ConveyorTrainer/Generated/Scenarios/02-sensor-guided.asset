  - requirement: 6
    instruction: "\u041A\u043B\u044E\u0447\u043E\u043C \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u0435
      \u043E\u0431\u0435 \u0433\u0430\u0439\u043A\u0438."
    targetId: sensor.nut.0
  - requirement: 7
    instruction: "\u0421\u043D\u0438\u043C\u0438\u0442\u0435 \u0441\u0442\u0430\u0440\u044B\u0439
