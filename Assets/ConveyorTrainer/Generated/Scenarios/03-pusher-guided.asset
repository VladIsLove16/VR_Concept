      \u0442\u043E\u043B\u043A\u0430\u0442\u0435\u043B\u044F."
    targetId: pusher.bolt.0
  - requirement: 15
    instruction: "\u0421\u043D\u0438\u043C\u0438\u0442\u0435 \u0441\u0442\u0430\u0440\u044B\u0439
      \u0442\u043E\u043B\u043A\u0430\u0442\u0435\u043B\u044C \u0438 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435
      \u043D\u0430 \u0441\u0442\u043E\u043B."
    targetId: 
  - requirement: 16
    instruction: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439
