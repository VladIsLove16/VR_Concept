  - requirement: 0
    instruction: "\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043B\u0438\u043D\u0438\u044E."
    targetId: power.start
  - requirement: 20
    instruction: "\u0414\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439
