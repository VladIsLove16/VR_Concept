  title: "\u0417\u0430\u043C\u0435\u043D\u0430 \u0442\u043E\u043B\u043A\u0430\u0442\u0435\u043B\u044F"
  briefing: "\u0417\u0430\u043C\u0435\u043D\u0438\u0442\u0435 \u043D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u044B\u0439
    \u0442\u043E\u043B\u043A\u0430\u0442\u0435\u043B\u044C \u0441 \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435\u043C
    \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F."
  fault: 2
  guided: 1
  steps:
  - requirement: 4
    instruction: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u043B\u0438\u043D\u0438\u044E."
    targetId: power.stop
  - requirement: 11
    instruction: "\u041F\u0435\u0440\u0435\u043A\u0440\u043E\u0439\u0442\u0435 \u043F\u043E\u0434\u0430\u0447\u0443
      \u0432\u043E\u0437\u0434\u0443\u0445\u0430."
    targetId: air
  - requirement: 12
    instruction: "\u0421\u0442\u0440\u0430\u0432\u0438\u0442\u0435 \u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0435
      \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435."
    targetId: vent
  - requirement: 13
    instruction: "\u041E\u0442\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435
      \u043E\u0431\u0435 \u0442\u0440\u0443\u0431\u043A\u0438."
    targetId: pusher.tube.0
  - requirement: 14
    instruction: "\u041C\u043E\u043D\u0442\u0430\u0436\u043D\u044B\u043C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C
