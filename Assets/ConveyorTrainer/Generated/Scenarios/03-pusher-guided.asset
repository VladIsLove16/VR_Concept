    targetId: 
  - requirement: 17
    instruction: "\u0417\u0430\u0442\u044F\u043D\u0438\u0442\u0435 \u043A\u0440\u0435\u043F\u0451\u0436
      \u0442\u043E\u043B\u043A\u0430\u0442\u0435\u043B\u044F."
    targetId: pusher.bolt.0
  - requirement: 18
    instruction: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043E\u0431\u0435
      \u0442\u0440\u0443\u0431\u043A\u0438."
    targetId: pusher.tube.0
  - requirement: 19
    instruction: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043F\u043E\u0434\u0430\u0447\u0443
